# Copy to .env. Environment variables override this file. No secrets required.
BROKER_HOST=127.0.0.1
BROKER_PORT=8080
BROKER_STATE_FILE=broker_state.json
CONSUMER_INBOX_FILE=consumer_inbox.sqlite3
BROKER_LOG_FILE=broker.log.jsonl
MAX_ATTEMPTS=3
ACK_TIMEOUT=5
BACKOFF_BASE=1
BACKOFF_CAP=15
RETRY_JITTER=0.25
IO_TIMEOUT=3

# Delay before first delivery of a newly published message (seconds).
DELIVERY_DELAY=3
